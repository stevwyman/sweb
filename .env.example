# Copy to .env (never commit .env).
# Generate a new secret: openssl rand -base64 33

AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Comma-separated email:password pairs. No database is used.
# Sessions are encrypted JWTs stored in an HTTP-only cookie.
AUTH_USERS=demo@example.com:changeme-demo

# Hugo paths that require a signed-in session. Comma-separated.
PROTECTED_PATHS=/members
